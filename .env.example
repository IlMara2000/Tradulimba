[TEMPLATE]
# Optional in locale. Su Vercel viene usato automaticamente VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# Modello opzionale per il post-editing delle varianti.
TRANSLATION_AI_MODEL=openai/gpt-5-mini

# Voce sarda: motore TTS compatibile via HTTP (consigliato in produzione).
# Contratto ed esempi in docs/voce-sarda.md.
SARDINIAN_TTS_URL=
SARDINIAN_TTS_KEY=
SARDINIAN_TTS_FORMAT=mp3

# In locale puoi usare eSpeak NG con la voce sc: npm run voice:setup
SARDINIAN_ESPEAK_BIN=
SARDINIAN_ESPEAK_DATA=
SARDINIAN_ESPEAK_VOICE=sc
SARDINIAN_ESPEAK_SPEED=145
